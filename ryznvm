echo -e "${YELLOW} 2)${WHITE} Manage Instances"
echo -e "${YELLOW} 3)${WHITE} Cloud Backup"
echo -e "${YELLOW} 4)${WHITE} Load Balancer"
echo -e "${YELLOW} 5)${WHITE} Firewall Rules"
echo -e "${YELLOW} 6)${WHITE} Back"
echo -e "${C3}─────────────────────────────────────────────${NC}"
read -p "Select → " c

case $c in
 1) bash <(curl -s https://raw.githubusercontent.com/ryzncloud/scripts/main/deploy.sh) ;;
 2) bash <(curl -s https://raw.githubusercontent.com/ryzncloud/scripts/main/manage.sh) ;;
 3) bash <(curl -s https://raw.githubusercontent.com/ryzncloud/scripts/main/backup.sh) ;;
